LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
OPENAI_API_KEY=your_openai_api_key
# Leave false to use the HTTPS STT + Chat + TTS pipeline. Enable only when
# the machine can establish a WebSocket connection to api.openai.com.
OPENAI_REALTIME_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=shimmer
# Optional proxy used only for the OpenAI Realtime WebSocket. Do not use
# HTTPS_PROXY here unless LiveKit should also be routed through that proxy.
OPENAI_HTTP_PROXY=
OPENAI_AGENT_LANGUAGE=English
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=en
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Optional OpenAI-compatible endpoint, for example https://proxy.example/v1
OPENAI_BASE_URL=
LIVEKIT_AGENT_NAME=chronos-agent
# The first signal handshake can take longer after a network/VPN switch.
LIVEKIT_CONNECT_RETRIES=3
LIVEKIT_CONNECT_RETRY_DELAY=1
